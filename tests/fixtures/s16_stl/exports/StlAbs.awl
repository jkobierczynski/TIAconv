FUNCTION "StlAbs" : Void
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   VAR_TEMP 
      a : Int;
      b : Bool;
      c : Int;
      p : Any;
      x : Int;
   END_VAR


BEGIN
NETWORK
TITLE = the open DB, absolute and fully qualified:
      OPN "S16Data";
      SET;
      = %DBX0.1;
      L 7;
      T %DBB1;
      L 1234;
      T %DBW2;
      L "S16Data".w;
      + 1;
      T "S16Data".arr[1];
      OPN "S16Data";
      L 2.5;
      T %DBD8;
      L DBNO;
      T "Tag_6";

NETWORK
TITLE = AR1, AR2, register- and memory-indirect:
      OPN "S16Data";
      L P#20.0;
      LAR1;
      L 42;
      T DBW[ AR1, P#2.0];
      L P#M40.0;
      LAR2;
      L 99;
      T W[ AR2, P#0.0];
      L 16;
      T "Tag_7";
      L DBW[ "Tag_7"];
      T "Tag_8";

NETWORK
TITLE = local data by address:
      L 5;
      T #a;
      L #a;
      + 1;
      T #c;
      SET;
      = %L2.1;
      A %L2.1;
      = "Tag_9";
      L 42;
      T #x;
      L #x;
      T "Tag_10";
      L P##c;
      LAR1;
      L 77;
      T W[ AR1, P#0.0];
      L #c;
      T "Tag_11";

END_FUNCTION

