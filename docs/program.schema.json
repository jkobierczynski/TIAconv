{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jkobierczynski/TIAconv/docs/program.schema.json",
  "title": "tiaconv program export",
  "description": "The program of one PLC, as tiaconv --program-json writes it. See docs/PROGRAM-JSON.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "tool",
    "source",
    "plc",
    "io",
    "tags",
    "constants",
    "types",
    "data_blocks",
    "organization_blocks",
    "blocks",
    "instructions",
    "call_graph",
    "not_simulatable"
  ],
  "properties": {
    "format": {
      "const": "tiaconv-program"
    },
    "schema_version": {
      "const": 2
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "tiaconv"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "project",
        "save"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "save": {
          "type": [
            "integer",
            "null"
          ],
          "description": "the project as it was after this save; null: as it is now"
        }
      }
    },
    "plc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "station",
        "type",
        "order_number",
        "firmware"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "station": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "order_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "io": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "station",
          "module",
          "item",
          "area",
          "start_bit",
          "length_bits",
          "process_image",
          "text"
        ],
        "properties": {
          "station": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "item": {
            "type": [
              "string",
              "null"
            ]
          },
          "area": {
            "enum": [
              "I",
              "Q"
            ]
          },
          "start_bit": {
            "type": "integer"
          },
          "length_bits": {
            "type": "integer"
          },
          "process_image": {
            "type": "integer",
            "description": "0: automatic update"
          },
          "text": {
            "type": "string",
            "description": "\"I 64...67\""
          }
        }
      },
      "description": "the I/O addresses of the modules of the PLC's station and of the IO devices it controls"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "table",
          "data_type",
          "type",
          "address",
          "comment"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "table": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "$ref": "#/$defs/type"
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "table",
          "data_type",
          "value",
          "parsed",
          "kind",
          "system",
          "comment"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "table": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "parsed": {
            "oneOf": [
              {
                "$ref": "#/$defs/value"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "description": "hardware, ob, pip, user, system"
          },
          "system": {
            "type": "boolean"
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "members"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "plc_type",
              "system_type"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/member"
            }
          }
        }
      },
      "description": "PLC data types (from their definition where it was read) and the system types met in the members (TON_TIME, DTL), with their members"
    },
    "data_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "number",
          "kind",
          "instance_of",
          "optimized",
          "notes",
          "members"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "description": "global, instance"
          },
          "instance_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "optimized": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/member"
            }
          }
        }
      }
    },
    "organization_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "number",
          "event",
          "priority",
          "cycle_us",
          "phase_shift_us"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "event": {
            "type": [
              "string",
              "null"
            ],
            "description": "ProgramCycle, CyclicInterrupt, Startup, ..."
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cycle_us": {
            "type": [
              "integer",
              "null"
            ]
          },
          "phase_shift_us": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "major.minor of the library version"
          }
        }
      },
      "description": "the instructions the code uses"
    },
    "call_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "from_type",
          "network",
          "kind",
          "to",
          "to_type",
          "instance_kind",
          "instance"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "from_type": {
            "type": "string"
          },
          "network": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "block",
              "instruction",
              "builtin",
              "unknown"
            ]
          },
          "to": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "instance_kind": {
            "type": [
              "string",
              "null"
            ],
            "description": "data_block, multi_instance, unknown"
          },
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "the data block, or the member path as #a.b"
          }
        }
      },
      "description": "one entry per call in the code, in the order of the blocks and networks"
    },
    "not_simulatable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block",
          "type",
          "reason"
        ],
        "properties": {
          "block": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "bits",
        "length",
        "dims",
        "element"
      ],
      "properties": {
        "kind": {
          "enum": [
            "elementary",
            "string",
            "array",
            "struct",
            "plc_type",
            "system_type",
            "instance",
            "parameter",
            "void",
            "named",
            "unknown"
          ],
          "description": "named: a quoted name that is not a PLC data type or FB of this PLC"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Int, String, Array, Struct, the name of the PLC data type, system type or FB, Variant, ..."
        },
        "bits": {
          "type": [
            "integer",
            "null"
          ],
          "description": "elementary: the size in bits"
        },
        "length": {
          "type": [
            "integer",
            "null"
          ],
          "description": "string: the maximum number of characters"
        },
        "dims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "low",
              "low_text",
              "high",
              "high_text"
            ],
            "properties": {
              "low": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "null when not known: a variable bound (*) or a constant not found"
              },
              "low_text": {
                "type": "string",
                "description": "as written: 0, #MAX, \"MAX\", *"
              },
              "high": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "high_text": {
                "type": "string"
              }
            }
          },
          "description": "array: one entry per dimension"
        },
        "element": {
          "oneOf": [
            {
              "$ref": "#/$defs/type"
            },
            {
              "type": "null"
            }
          ],
          "description": "array: the type of an element"
        }
      },
      "description": "a data type taken apart"
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "bool",
        "int",
        "real",
        "ns",
        "days",
        "string"
      ],
      "properties": {
        "kind": {
          "enum": [
            "bool",
            "int",
            "real",
            "duration",
            "date",
            "time_of_day",
            "date_and_time",
            "string",
            "char",
            "unknown"
          ]
        },
        "text": {
          "type": "string",
          "description": "as written (empty for the default value of a constant that stores none)"
        },
        "bool": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "int": {
          "type": [
            "integer",
            "null"
          ],
          "description": "int: the value, also of a bit string (16#FF: 255); char: its code"
        },
        "real": {
          "type": [
            "number",
            "null"
          ]
        },
        "ns": {
          "type": [
            "integer",
            "null"
          ],
          "description": "duration in nanoseconds; time_of_day: since midnight; date_and_time: since 1970-01-01"
        },
        "days": {
          "type": [
            "integer",
            "null"
          ],
          "description": "date: since 1990-01-01"
        },
        "string": {
          "type": [
            "string",
            "null"
          ],
          "description": "string, char: the characters, escapes ($', $N, $hh) decoded, as UTF-8"
        }
      },
      "description": "a value parsed"
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_type",
        "type",
        "section",
        "offset",
        "offset_bits",
        "start_value",
        "start",
        "retain",
        "accessible_from_hmi",
        "writable_from_hmi",
        "setpoint",
        "unresolved",
        "comment",
        "members"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "as TIA Portal writes it: Bool, Int, Array[0..9] of Real, String[20], \"MyUdt\", TON_TIME"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "section": {
          "type": [
            "string",
            "null"
          ],
          "description": "Input, Output, InOut, Static, Temp, Constant, Return; null in a global data block and below the top level"
        },
        "offset": {
          "type": [
            "string",
            "null"
          ],
          "description": "byte or byte.bit from the start of the data block or instance, \"12\", \"12.3\"; only with standard (not optimized) access"
        },
        "offset_bits": {
          "type": [
            "integer",
            "null"
          ],
          "description": "the same in bits"
        },
        "start_value": {
          "type": [
            "string",
            "null"
          ],
          "description": "as written in the project; null: the default of the type (or of an enclosing structure)"
        },
        "start": {
          "oneOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ],
          "description": "start_value parsed; null with it"
        },
        "retain": {
          "type": "boolean"
        },
        "accessible_from_hmi": {
          "type": "boolean",
          "description": "Accessible from HMI/OPC UA/Web API, as limited by an enclosing structure"
        },
        "writable_from_hmi": {
          "type": "boolean",
          "description": "Writable from HMI/OPC UA/Web API, as limited by an enclosing structure"
        },
        "setpoint": {
          "type": "boolean"
        },
        "unresolved": {
          "type": "boolean",
          "description": "the nested type could not be followed; members may be missing"
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "description": "members of a structure, UDT, multi-instance or array element type"
        }
      }
    },
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "ref_id",
        "linked",
        "kind",
        "data_type",
        "data_type_from_pin",
        "data_block",
        "address",
        "pin_type",
        "value"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "as written in code: \"Tag\", \"DB\".member, #local, 5, T#5S"
        },
        "ref_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "the entry of the block's references"
        },
        "linked": {
          "type": "boolean",
          "description": "the entry was found"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "tag, data block member, local, constant, local constant, user constant, ..."
        },
        "data_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_type_from_pin": {
          "type": "boolean",
          "description": "data_type is the pin's: a literal stored without a type"
        },
        "data_block": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "description": "a tag's address (%M10.0); a member of a data block with standard access: %DB1.DBX60.0, %DB2.DBW4"
        },
        "pin_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "the type the pin takes, where tiaconv knows it"
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ],
          "description": "a constant (literal, local or user constant): its value"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction",
        "connected",
        "operands"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "in",
            "out"
          ]
        },
        "connected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "an operand as written in code, \"power rail\", or the pin of another part as \"<uid>.<pin>\""
        },
        "operands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          },
          "description": "the operands among connected, in that order"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "kind",
        "name",
        "ref_id",
        "instance",
        "instance_ref_id",
        "data_type",
        "options",
        "pins"
      ],
      "properties": {
        "uid": {
          "type": "integer"
        },
        "kind": {
          "enum": [
            "gate",
            "call",
            "instruction"
          ]
        },
        "name": {
          "type": "string",
          "description": "the gate as stored (Contact, Coil, Add, Move, ...), the block called, or the instruction"
        },
        "ref_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "call, instruction: its entry of the references"
        },
        "instance": {
          "type": [
            "string",
            "null"
          ]
        },
        "instance_ref_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "data_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "the type a box was set to; null when not set (an AutomaticTyped option: Auto)"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          "description": "what the part was set to: SrcType, Card (number of inputs), DisableENO, negated (a negated pin), AutomaticTyped"
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "block_type",
        "name",
        "number",
        "version",
        "instance",
        "parameters"
      ],
      "properties": {
        "kind": {
          "enum": [
            "block",
            "instruction",
            "builtin",
            "unknown"
          ],
          "description": "block: an FB or FC of this PLC, in blocks; instruction: from a Siemens library (TON, PID_Compact), in instructions; builtin: a function of the language (INT_TO_WORD, ABS)"
        },
        "block_type": {
          "type": [
            "string",
            "null"
          ],
          "description": "FB, FC; for an instruction kept as a block, its type"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "the block or instruction, without quotes"
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "description": "block: its number"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "instruction: its library version"
        },
        "instance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "name",
                "number",
                "instance_of",
                "data_type",
                "path"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "data_block",
                    "multi_instance",
                    "unknown"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "data_block: the data block; multi_instance: the last member of the path"
                },
                "number": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "data_block: its number"
                },
                "instance_of": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "data_block: what the data block is an instance of"
                },
                "data_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "multi_instance: the type of the member"
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "index"
